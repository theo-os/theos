  public_configs = [":curl_config", ":openssl_config"]
  deps = [ ":openssl" ]
  libs = [ "ws2_32.lib", "crypt32.lib", "wldap32.lib", "advapi32.lib", "secur32.lib", "Normaliz.lib" ]
}

config("zstd_config") { include_dirs = [ "zstd/lib" ] }
source_set("zstd") { public_configs = [ ":zstd_config" ] }
config("zlib_ng_config") { include_dirs = [ "zlib-ng" ] }
source_set("zlib-ng") { public_configs = [ ":zlib_ng_config" ] }
third_party_abs = rebase_path(".", "")
openssl_crypto_abs = rebase_path("openssl/crypto", "")
openssl_ssl_abs = rebase_path("openssl/ssl", "")
openssl_providers_abs = rebase_path("openssl/providers", "")

# OpenSSL sources are generated from the checked-in tree with a Windows filter.
openssl_sources = exec_script("list_files.py", [ third_party_abs, openssl_crypto_abs, openssl_ssl_abs, openssl_providers_abs ], "list lines")

config("openssl_config") {
  include_dirs = [ "openssl/generated/include", "openssl", "openssl/include", "openssl/providers/common/include", "openssl/providers/implementations/include" ]
  defines = [
    "OPENSSL_NO_BROTLI",
    "OPENSSL_NO_COMP",
    "OPENSSL_NO_COMP_ALG",
    "OPENSSL_NO_JITTER",
    "OPENSSL_NO_KTLS",
    "OPENSSL_NO_SCTP",
    "OPENSSL_NO_ZLIB",
    "OPENSSL_NO_ZSTD",
    "WIN32_LEAN_AND_MEAN",
  ]
  cflags = [
    "-w",
    "-Wno-deprecated-declarations",
    "-Wno-macro-redefined",
    "-Wno-sign-compare",
    "-Wno-unused-function",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
  ]
}
static_library("openssl") {
  sources = openssl_sources
  public_configs = [ ":openssl_config" ]
  libs = [ "ws2_32.lib", "gdi32.lib", "advapi32.lib", "crypt32.lib", "user32.lib", "bcrypt.lib" ]
}
config("libexpat_config") { include_dirs = [ "libexpat/expat/lib" ] }
source_set("libexpat") { public_configs = [ ":libexpat_config" ] }
