# ── Platform targets ─────────────────────────────────────────────────────────

platform(
    name = "uefi",
    constraint_values = [
        "prelude//cpu/constraints:x86_64",
        "prelude//os/constraints:none",
    ],
    visibility = ["PUBLIC"],
)

