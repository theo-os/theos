package(default_visibility = ["//visibility:public"])

platform(
    name = "uefi",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:uefi",
    ],
)

toolchain(
    name = "uefi_cc_toolchain",
    toolchain = "@local_config_cc//:cc-compiler-k8",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:uefi",
    ],
)
